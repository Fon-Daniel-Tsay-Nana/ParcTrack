PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/parctrack

# Random string (32+ characters) used to sign admin sessions - required in production
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# First administrator - created on startup if it doesn't exist yet
ADMIN_EMAIL=admin@parctrack.example
ADMIN_PASSWORD=change-me-please

# Set to "off" to skip OpenStreetMap place lookups when creating shipments
GEOCODING=on

# Automatic parcel movement: how often (seconds) moving parcels are advanced and pushed to customers
MOVE_TICK_SECONDS=30
# Set to "off" to use straight lines instead of OSRM road routes
ROUTING=on
